{
  "name": "@aidreams/remotion-templates",
  "version": "0.1.0",
  "private": true,
  "description": "Адаптированные под интеграцию шаблоны Remotion (форк reactvideoeditor/remotion-templates)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "18.3.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.545",
    "typescript": "5.6.3"
  }
}
